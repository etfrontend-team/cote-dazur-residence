{
  "name": "html-setup",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build": "npx tailwindcss -i ./assets/css/style.css -o ./dist/style.css --watch",
    "build:prod": "npm run vendor && npx tailwindcss -i ./assets/css/style.css -o ./dist/style.css --minify",
    "vendor": "mkdir -p assets/vendor/gsap assets/vendor/lenis && cp node_modules/gsap/index.js node_modules/gsap/gsap-core.js node_modules/gsap/CSSPlugin.js node_modules/gsap/ScrollTrigger.js node_modules/gsap/Observer.js assets/vendor/gsap/ && cp node_modules/lenis/dist/lenis.mjs assets/vendor/lenis/",
    "lint:fix": "npx eslint . --fix && npx prettier --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,html}": [
      "eslint --fix"
    ],
    "*.{js,jsx,ts,tsx,html,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.23",
    "swiper": "^12.2.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^1.2.0",
    "@html-eslint/eslint-plugin": "^0.60.0",
    "@html-eslint/parser": "^0.60.0",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "playwright": "^1.62.1",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0"
  }
}
